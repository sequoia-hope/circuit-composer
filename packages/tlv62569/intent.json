  "blocks": {
    "reg": {
      "type": "buck",
      "parts": [
        "U1",
        "L1",
        "CIN",
        "COUT",
        "RFB_TOP",
        "RFB_BOT",
        "CFF",
        "R_EN"
      ],
      "roles": {
        "vin": "U1.4",
        "sw": "U1.3",
        "pgnd": "U1.2",
        "fb": "U1.5",
        "cin": "CIN",
        "cout": "COUT",
        "inductor": "L1"
      },
      "placement_goal": {
        "objectives": [
          {
            "metric": "hot_loop_area_mm2",
            "sense": "minimize",
            "weight": 1.0
          },
          {
            "metric": "switch_node_area_mm2",
            "sense": "minimize",
            "weight": 0.5
          },
          {
            "metric": "output_loop_area_mm2",
            "sense": "minimize",
            "weight": 0.5
          }
        ],
        "constraints": [
          {
            "value": {
              "metric": "feedback_clearance_mm",
              "op": ">=",
              "limit": 0.3,
              "nets": [
                "FB",
                "SW"
              ]
            },
            "strength": "soft",
            "provenance": {
              "source": "tlv62569_ds",
              "locator": "§10.1 p.13",
              "kind": "datasheet",
              "note": "Datasheet: keep FB sense traces away from SW nodes, no distance given. 0.3 mm is the rp2350 package's floor, borrowed; soft until a source or a measurement gives one. With the divider the checked path is FB pin to the nearest divider pad (crates/verify/src/buck.rs); the VOUT sense run from COUT to RFB_TOP is not covered."
            }
          }
        ]
      },
      "ports": {
        "vin": {
          "kind": "supply",
          "nets": [
            "VIN"
          ],
          "direction": "in",
          "voltage_v": 4.2,
          "current_a": 0.6
        },
        "out": {
          "kind": "supply",
          "nets": [
            "VOUT"
          ],
          "direction": "out",
          "voltage_v": 3.3,
          "current_a": 0.6
        },
        "en": {
          "kind": "signal",
          "nets": [
            "EN"
          ],
          "direction": "in"
        },
        "gnd": {
          "kind": "ground",
          "nets": [
            "GND"
          ]
        }
      },
      "note": "U1 is the TLV62569DBV (SOT-23-5): 1 EN, 2 GND, 3 SW, 4 VIN, 5 FB. The GND pin is both power and signal ground (no exposed pad, no separate AGND). The feedback divider is external (RFB_TOP from VOUT to FB, RFB_BOT from FB to GND, CFF across RFB_TOP), so `fb` is not on the output net. Part references are roles, renamed when composed onto a board. No switch_node_underlap constraint: this datasheet does not ask for the plane under SW to be cut (see the library dispute buck.sw.keep_ground_under)."
    }
  },
