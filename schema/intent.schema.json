        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for `hard`; the validator refuses a hard constraint without one."
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        },
        "value": {
          "$ref": "#/$defs/Noise"
        },
        "weight": {
          "description": "For `soft` only: how much this weighs against other soft goals, in (0, 1].",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "strength"
      ],
      "type": "object"
    },
