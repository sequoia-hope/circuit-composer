        "peak_a": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "continuous_a"
      ],
      "type": "object"
    },
    "Direction": {
      "enum": [
        "in",
        "out",
        "bidirectional"
      ],
      "type": "string"
    },
    "Domain": {
      "additionalProperties": false,
      "description": "A node of the domain tree: board, then isolation islands, then ground zones, then blocks.",
      "properties": {
        "barriers": {
          "items": {
            "$ref": "#/$defs/Barrier"
          },
          "type": "array"
        },
        "blocks": {
          "description": "Block ids that live directly in this domain.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Domain"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/DomainKind"
        },
        "name": {
          "description": "Unique across the tree.",
          "type": "string"
        },
        "reference_ground": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "switchable": {
          "default": false,
          "description": "Whether the domain can be powered off while its siblings run.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "DomainKind": {
      "enum": [
        "board",
        "isolation_island",
        "ground_zone",
        "group"
      ],
      "type": "string"
    },
    "EnergyKind": {
      "enum": [
        "battery",
        "supply_input",
        "capacitor_bank"
      ],
      "type": "string"
    },
    "EnergySource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EnergyKind"
        },
        "net": {
          "type": "string"
        },
        "protected_zone": {
          "description": "The `protected_zone` region bounding copper upstream of the first disconnect.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "net",
        "kind"
      ],
      "type": "object"
    },
    "FaultCurrent": {
      "additionalProperties": false,
      "properties": {
        "amps": {
          "format": "double",
          "type": "number"
        },
        "duration_ms": {
          "description": "How long until protection opens.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "amps",
        "duration_ms"
      ],
      "type": "object"
    },
    "Impedance": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ImpedanceMode"
        },
        "ohms": {
          "format": "double",
          "type": "number"
        },
        "pair": {
          "description": "For `differential`: the other net of the pair.",
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance_pct": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "ohms",
        "tolerance_pct",
        "mode"
      ],
      "type": "object"
    },
    "ImpedanceMode": {
      "enum": [
        "single_ended",
        "differential"
      ],
      "type": "string"
    },
    "Length": {
      "additionalProperties": false,
      "properties": {
        "mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "mm"
      ],
      "type": "object"
    },
    "Level": {
      "enum": [
        "none",
        "weak",
        "moderate",
        "strong"
      ],
      "type": "string"
    },
    "MatchGroup": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "tolerance_mm": {
          "description": "Allowed spread within the group, as length or as delay (one of the two).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tolerance_ps": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "Metric": {
      "description": "The metric vocabulary. A metric is here only once a generator or verifier check computes it.",
      "oneOf": [
        {
          "const": "hot_loop_area_mm2",
          "description": "Area enclosed by a switching block's high-di/dt loop, mm².",
          "type": "string"
        },
        {
          "const": "output_loop_area_mm2",
          "description": "Area enclosed by a buck's output loop (switch, inductor, output capacitor), mm².",
          "type": "string"
        },
        {
          "const": "switch_node_underlap_mm2",
          "description": "Other nets' copper on the layer under a switch node's outer copper, mm².",
          "type": "string"
        },
        {
          "const": "switch_node_area_mm2",
          "description": "Copper area of a switch node, mm².",
          "type": "string"
        },
        {
          "const": "feedback_clearance_mm",
          "description": "Distance from a feedback net to switch-node copper, mm.",
          "type": "string"
        },
        {
          "const": "clearance_mm",
          "description": "Distance between two nets' copper, mm.",
          "type": "string"
        },
        {
          "const": "part_distance_mm",
          "description": "Distance between two parts' nearest pads, mm.",
          "type": "string"
        },
        {
          "const": "trace_length_mm",
          "description": "Routed length of a net, mm.",
          "type": "string"
        },
        {
          "const": "via_count",
          "description": "Vias on a net.",
          "type": "string"
        },
        {
          "const": "unreferenced_length_mm",
          "description": "Track of a net with no ground fill on a neighbouring copper layer (a broken return path), mm.",
          "type": "string"
        },
        {
          "const": "decoupling_path_mm",
          "description": "Copper path from a power pin to its nearest decoupling capacitor, mm.",
          "type": "string"
        }
      ]
    },
    "MetricBound": {
      "additionalProperties": false,
      "description": "`metric op limit`, e.g. `feedback_clearance_mm >= 1.0` between `nets`.",
      "properties": {
        "limit": {
          "format": "double",
          "type": "number"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "nets": {
          "description": "The nets the metric is measured on; for a clearance, the two sides.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "op": {
          "$ref": "#/$defs/BoundOp"
        },
        "parts": {
          "description": "Parts the metric is measured on, when it is about placement.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "metric",
        "op",
        "limit"
      ],
      "type": "object"
    },
    "NetIntent": {
      "additionalProperties": false,
      "description": "Intent for one net. Categories (`class`) are presets over these attributes.",
      "properties": {
        "aggressor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr"
            },
            {
              "type": "null"
            }
          ],
          "description": "How much noise the net emits."
        },
        "bandwidth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr2"
            },
            {
              "type": "null"
            }
          ]
        },
        "class": {
          "description": "A net class preset name (`POWER`, `SWITCH`, `DIFF_HS`, ...). It decides which attributes\nare required and supplies soft defaults for the rest.",
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr4"
            },
            {
              "type": "null"
            }
          ]
        },
        "fault_current": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr5"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current the copper must survive until protection opens."
        },
        "impedance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr6"
            },
            {
              "type": "null"
            }
          ]
        },
        "match_group": {
