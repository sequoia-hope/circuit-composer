        "slow_precise",
        "digital",
        "wideband"
      ],
      "type": "string"
    },
    "Barrier": {
      "additionalProperties": false,
      "description": "An isolation barrier to a sibling domain.",
      "properties": {
        "clearance_mm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attr12"
            },
            {
              "type": "null"
            }
          ]
        },
        "creepage_mm": {
          "$ref": "#/$defs/Attr12"
        },
        "to": {
          "description": "The sibling domain's name.",
          "type": "string"
        }
      },
      "required": [
        "to",
        "creepage_mm"
      ],
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "description": "The package this block comes from, `name@version`, when composed from one.",
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "description": "Member parts by reference designator.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "placement_goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlacementGoal"
            },
            {
              "type": "null"
            }
          ]
        },
        "ports": {
          "additionalProperties": {
            "$ref": "#/$defs/Port"
          },
          "description": "External interface, keyed by port name.",
          "type": "object"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Who plays each role the block type names: pads as `REF.PIN`, parts by reference. A\nbuck names `vin`, `sw`, `pgnd`, `fb` (the IC's pads) and `cin`, `cout`, `inductor`.",
          "type": "object"
        },
        "type": {
          "description": "A block type from the block library (`buck`, `ldo`, `crystal`, ...).",
          "type": "string"
        }
      },
      "required": [
        "type",
        "parts"
      ],
      "type": "object"
    },
    "BoardInfo": {
      "additionalProperties": false,
      "properties": {
        "kicad_project": {
          "description": "The KiCad project this file is the sidecar of, relative to this file.",
          "type": [
            "string",
            "null"
          ]
        },
        "layers": {
          "description": "Copper layer count, when decided.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact package versions this board was composed from, like a lockfile: `rp2350 = \"0.1.0\"`.",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "BoundOp": {
      "enum": [
        "<=",
        ">="
      ],
      "type": "string"
    },
    "ClaimKind": {
      "oneOf": [
        {
          "const": "datasheet",
          "description": "Stated by a manufacturer: datasheet, design guide, reference board.",
          "type": "string"
        },
        {
          "const": "expert",
          "description": "Stated by a person with expertise: a book, a talk, a reviewer.",
          "type": "string"
        },
        {
          "const": "simulated",
          "description": "Shown by simulation in this system's verifier.",
          "type": "string"
        },
        {
          "const": "requirement",
          "description": "The board's own requirement, decided by its designer (a budget, a connector rating).",
          "type": "string"
        },
        {
          "const": "preset",
          "description": "Filled in from a class preset; never satisfies a hard constraint.",
          "type": "string"
        }
      ]
    },
    "Current": {
      "additionalProperties": false,
      "properties": {
        "continuous_a": {
          "format": "double",
          "type": "number"
